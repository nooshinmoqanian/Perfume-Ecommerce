{
    "compilerOptions":  {
                            "target":  "ES2020",
                            "module":  "CommonJS",
                            "outDir":  "dist",
                            "rootDir":  "..",
                            "baseUrl":  ".",
                            "paths":  {

                                      },
                            "strict":  true,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "forceConsistentCasingInFileNames": true,
                            "ignoreDeprecations": "5.0"
                        },
    "include":  [
                    "src/**/*.ts",
                    "../libs/common/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ]
}
